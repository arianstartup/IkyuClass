# Firebase
FIREBASE_SERVICE_ACCOUNT_KEY_PATH="./serviceAccountKey.json"

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID="YOUR_ZARINPAL_MERCHANT_ID"
ZARINPAL_SANDBOX_MODE="true" # true for sandbox, false for production

# Simulated SMS Provider
SIMULATED_SMS_API_KEY="YOUR_SIMULATED_SMS_API_KEY"
SIMULATED_SMS_SENDER_NUMBER="YOUR_SENDER_PHONE_NUMBER"

# Admin Access (Temporary - for dev only)
ADMIN_SECRET_KEY="REPLACE_WITH_A_STRONG_SECRET_KEY"

# AI Service (e.g., Gemini)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_IF_NOT_USING_DB_SETTINGS"

# Email SMTP Configuration (Fallback if not set in Admin Panel)
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587" # (e.g., 587 for TLS, 465 for SSL, 25 for unencrypted)
EMAIL_SMTP_SECURE="false" # (use "true" for port 465, "false" for 587/25 with STARTTLS often)
EMAIL_SMTP_USER="your_smtp_username"
EMAIL_SMTP_PASS="your_smtp_password"
EMAIL_SENDER_ADDRESS="noreply@yourdomain.com" # Default "From" address for emails

# Application Configuration
NODE_ENV="development"
PORT="3001"

# Frontend URL (for callbacks)
FRONTEND_URL="http://localhost:3000"
CALLBACK_BASE_URL="http://localhost:3001" # Base URL for backend API callbacks
